{
  "store": "rimi",
  "url": "https://www.rimi.lt/e-parduotuve/lt/akcijos",
  "type": "dynamic",
  "container": ".js-product-container.card",

  "pagination": {
    "param": "currentPage",
    "startPage": 1,
    "pageSize": 40,
    "pageSizeParam": "pageSize",
    "maxPages": 5
  },

  "selectors": {
    "name": ".card__name",
    "price": {
      "format": "fallback",
      "options": [
        {
          "format": "split",
          "integer": ".price-label__price .major",
          "fraction": ".price-label__price .minor .cents"
        },
        {
          "format": "single",
          "selector": ".card__price-wrapper.-has-discount .price-tag.card__price .sr-only"
        }
      ]
    },
    "oldPrice": {
      "format": "fallback",
      "options": [
        ".old-price-tag.card__old-price .sr-only",
        ".card__price-wrapper:not(.-has-discount) .price-tag.card__price .sr-only"
      ]
    },
    "unitPrice": ".card__price-per",
    "image": {
      "selector": ".card__image-wrapper img",
      "attribute": "data-src"
    },
    "url": {
      "selector": "a.card__url",
      "attribute": "href",
      "baseUrl": "https://www.rimi.lt"
    }
  },

  "transforms": {
    "name": ["trim"],
    "unitPrice": ["trim", "collapseWhitespace"]
  }
}
