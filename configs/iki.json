{
  "store": "iki",
  "url": "https://iki.lt/akcijos/savaites-akcijos/",
  "type": "dynamic",
  "container": ".akcijoskortele",

  "scroll": {
    "delay": 1.5,
    "maxScrolls": 50
  },

  "selectors": {
    "name": ".akcija_title",
    "price": {
      "format": "split",
      "integer": ".price_block_wrapper > .price_int",
      "fraction": ".price_block_wrapper > .price_cents > .sub"
    },
    "oldPrice": {
      "format": "split",
      "integer": ".price_old_block .price_int",
      "fraction": ".price_old_block .price_cents"
    },
    "image": {
      "selector": ".akcija__image img",
      "attribute": "src"
    },
    "validDates": {
      "selector": ".akcija_description.text-center",
      "regex": "Galioja:\\s*(.+)"
    },
    "discount": {
      "format": "composed",
      "requirePercent": true,
      "parts": [
        ".price_block_rounded_red_wrapper .minus",
        ".price_block_rounded_red_wrapper .main",
        ".price_block_rounded_red_wrapper .percentage"
      ]
    },
    "condition": {
      "format": "fallback",
      "options": [
        {
          "selector": ".pigintuvas_wrapper",
          "textSeparator": " "
        },
        {
          "selector": ".nplusn_tag",
          "textSeparator": " "
        },
        {
          "selector": ".price_block_rounded_red_wrapper:not(:has(.percentage)) .main"
        }
      ]
    }
  },

  "loyaltyCard": {
    "indicator": ".card_tag, .card img[alt*='IKI Card']"
  },

  "transforms": {
    "name": ["trim", "collapseWhitespace"],
    "validDates": ["trim"],
    "condition": ["trim", "collapseWhitespace", "normalizeLtPriceSuffix"]
  }
}
