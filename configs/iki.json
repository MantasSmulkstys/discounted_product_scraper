{
  "store": "iki",
  "url": "https://iki.lt/akcijos/savaites-akcijos/",
  "type": "dynamic",
  "container": ".product",

  "discoverUrls": {
    "url": "https://iki.lt/akcijos/savaites-akcijos/",
    "selector": ".offers-types .items a, .offers-categories .items a",
    "attribute": "href",
    "type": "dynamic",
    "exclude": ["ispardavimo-prekes"]
  },

  "scroll": {
    "mode": "bottom",
    "delay": 2.0,
    "maxScrolls": 100,
    "batchScrolls": 100,
    "rounds": 4,
    "countSelector": ".product"
  },

  "selectors": {
    "name": "h2",
    "price": {
      "format": "split",
      "integer": ".price_block_wrapper > .price_int",
      "fraction": ".price_block_wrapper > .price_cents > .sub",
      "skipIfPercent": true
    },
    "oldPrice": {
      "format": "split",
      "integer": ".price_old_block .price_int",
      "fraction": ".price_old_block .price_cents"
    },
    "image": {
      "selector": "img.object-fit-cover",
      "attribute": "src"
    },
    "url": {
      "selector": "a[href]",
      "attribute": "href"
    },
    "validDates": {
      "selector": "p.text-px-14",
      "regex": "Galioja:\\s*(.+)"
    },
    "discount": {
      "format": "fallback",
      "options": [
        {
          "format": "composed",
          "requirePercent": true,
          "parts": [
            "[class*=\"red_wrapper\"]:not(.pigintuvas_wrapper) .minus",
            "[class*=\"red_wrapper\"]:not(.pigintuvas_wrapper) .main",
            "[class*=\"red_wrapper\"]:not(.pigintuvas_wrapper) .percentage"
          ]
        },
        {
          "format": "composed",
          "requirePercent": true,
          "parts": [
            ".price_block_wrapper .price_int",
            ".price_block_wrapper .price_int ~ .price_cents .sub"
          ]
        }
      ]
    },
    "condition": {
      "format": "fallback",
      "options": [
        {
          "selector": ".pigintuvas_wrapper",
          "textSeparator": " "
        },
        {
          "selector": ".nplusn_tag",
          "textSeparator": " "
        },
        {
          "selector": "[class*=\"red_wrapper\"]:not(:has(.percentage)) .main"
        }
      ]
    }
  },

  "loyaltyCard": {
    "indicator": ".card_tag, .card img[alt*='IKI Card']"
  },

  "transforms": {
    "name": ["trim", "collapseWhitespace"],
    "validDates": ["trim"],
    "condition": ["trim", "collapseWhitespace", "normalizeLtPriceSuffix"]
  }
}
